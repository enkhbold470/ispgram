# Database (Neon)
DATABASE_URL="postgresql://inky@localhost/ispgram"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/submit
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/submit
CLERK_WEBHOOK_SECRET=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Hugging Face API (Optional - for improved NSFW detection)
# Get free API key from: https://huggingface.co/settings/tokens
# Enables 96-98% accuracy vs 92-95% with local model only
HUGGINGFACE_API_KEY=

# Zoho Email Configuration
# Use your Zoho email account credentials
# SMTP settings: smtp.zoho.com, Port: 587 (TLS) or 465 (SSL)
ZOHO_EMAIL=your-email@zoho.com
ZOHO_PASSWORD=your-app-password
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
VOTING_ENABLED=true

# Email Unsubscribe Secret
# Used to generate secure unsubscribe tokens for email links
# Generate a random secret: openssl rand -base64 32
UNSUBSCRIBE_SECRET=