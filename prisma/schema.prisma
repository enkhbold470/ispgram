generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Student who shares an Education Week entry
model Student {
  id              String   @id @default(cuid())
  clerkId         String   @unique // Clerk user ID
  studentId       String?  @unique // De Anza student ID (optional for voting, required for entry submission)
  name            String
  email           String   @unique
  emailSubscribed Boolean  @default(true) // Email subscription preference
  createdAt       DateTime @default(now())
  
  // Relations
  entry     Entry?   // One student can submit one entry
  votes     Vote[]   // One student can vote multiple times
  
  @@index([studentId])
  @@index([clerkId])
  @@index([emailSubscribed])
  @@map("students")
}

// Education Week entry
model Entry {
  id          String   @id @default(cuid())
  studentId   String   @unique // One entry per student
  description String?  @db.Text
  photoUrl    String   // Vercel Blob URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  votes       Vote[]   // Entry can have many votes
  
  @@index([createdAt])
  @@map("entries")
}

// Vote (heart) on an entry
model Vote {
  id        String   @id @default(cuid())
  studentId String   // Who voted
  entryId   String   // Which entry they voted for
  createdAt DateTime @default(now())
  
  // Relations
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  
  // Each student can only vote once per entry
  @@unique([studentId, entryId])
  @@index([studentId])
  @@index([entryId])
  @@map("votes")
}
